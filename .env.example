# Copy to .env (git-ignored) only if you want a REAL AI provider.
# Demo mode needs NO configuration and NO API keys - it is the default.

# Which engine the UI/API uses when none is chosen: demo | openai | gemini | anthropic | bedrock
DEFAULT_PROVIDER=demo

# ---- OpenAI ----
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini          # example - use any chat model you have access to

# ---- Google Gemini ----
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash     # example - verify it is available to your key

# ---- Anthropic Claude ----
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- AWS Bedrock (also: pip install -r requirements-aws.txt) ----
# Credentials come from the standard AWS chain (aws configure / AWS_PROFILE / IAM role),
# not from this file. The model must be enabled for your account in that region.
# BEDROCK_REGION=us-west-2
# BEDROCK_MODEL_ID=                  # model or inference-profile ID, e.g. an Anthropic Claude ID

# ---- App ----
# DATABASE_PATH=data/incidents.db   # local SQLite file
# HISTORY_ENABLED=true              # false = never store incidents
# PROVIDER_TIMEOUT_SECONDS=45
# HOST=127.0.0.1                    # keep on localhost unless you add authentication
# PORT=5000
# FLASK_DEBUG=0
